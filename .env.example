# Banco e fila
DATABASE_URL="postgresql://gastemenos:gastemenos@127.0.0.1:5435/gastemenos?schema=public"
REDIS_URL="redis://localhost:6379"

# Tokens de sessao
JWT_SECRET="troque-em-producao-min-32-caracteres-aqui"
JWT_REFRESH_SECRET="troque-tambem-em-producao-min-32-caracteres"

# Hash das observacoes de preco (LGPD: userHash = HMAC do userId)
USER_HASH_SECRET="troque-em-producao-segredo-do-hmac-de-usuario"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/v1/auth/google/callback"

# Web Push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@gastemenos.com.br"

# E-mail
MAIL_FROM="GasteMenos <nao-responda@gastemenos.com.br>"
# Vazio em desenvolvimento: o codigo de 6 digitos vai para o log da API,
# para dar para testar o cadastro sem caixa postal. Preencha para enviar de verdade.
SMTP_URL=""

# Geocodificacao das lojas
GEOCODER_URL="https://nominatim.openstreetmap.org/search"
GEOCODER_USER_AGENT="GasteMenos/0.1 (contato@gastemenos.com.br)"

# Enderecos
APP_URL="http://localhost:5173"
API_URL="http://localhost:3001"
PORT=3001
NODE_ENV=development

# Multiplica os limites de requisicao, SOMENTE para a suite automatizada:
# os 3 projetos do Playwright rodam do mesmo IP e o limite e por IP.
# O boot recusa este valor em producao.
RATE_LIMIT_TEST_FACTOR=20
